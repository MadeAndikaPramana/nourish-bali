# Search engines: keep false until the owner says go-live.
PUBLIC_INDEXABLE=false
# Concept notices ("not affiliated", placeholder labels in the footer). Set to false once NOURISH owns the site.
PUBLIC_CONCEPT=true
SITE_URL=https://nourish-bali.vercel.app

# /admin — set these in Vercel → Project → Settings → Environment Variables.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Fine-grained token: this repo only, permission "Contents: Read and write" (+ "Commit statuses: Read" for publish status).
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=madeandikapramana/nourish-bali
GITHUB_BRANCH=main
# Optional. Defaults to a key derived from ADMIN_PASSWORD (changing the password logs everyone out).
SESSION_SECRET=
