---
import type { Category, Menu, MenuItem } from '@/lib/schema';
import { TAG_LABELS, TAGS } from '@/lib/schema';
import { formatAmount, formatPrices } from '@/lib/format';
import { servingLabel } from '@/lib/hours';

/**
 * The menu as plain, crawlable HTML. Filtering/search is layered on top by the MenuToolbar island,
 * which only toggles `hidden` on these nodes, so the menu still works with JavaScript off.
 */
interface Props {
  menu: Menu;
  rootId: string;
  /** Prefix for item anchors, e.g. "item" → #item-poke-bowl */
  anchorPrefix?: string;
}
const { menu, rootId, anchorPrefix = 'item' } = Astro.props;

function groups(items: MenuItem[]) {
  const out: { group?: string; items: MenuItem[] }[] = [];
  for (const it of items) {
    const last = out[out.length - 1];
    if (last && last.group === it.group) last.items.push(it);
    else out.push({ group: it.group, items: [it] });
  }
  return out;
}
const searchText = (c: Category, i: MenuItem) =>
  `${i.name} ${i.description ?? ''} ${i.group ?? ''} ${c.name} ${i.tags.map((t) => TAG_LABELS[t]).join(' ')}`
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '');
const labelled = (i: MenuItem) => i.prices.some((p) => p.label);
const priceTitle = menu.samplePrices ? 'Sample price, not the café’s real price' : 'Price in thousand rupiah';
---

<div data-menu-root={rootId} class="menu-root">
  {
    menu.samplePrices && (
      <div class="mb-8 flex items-start gap-3 rounded-2xl border border-dashed border-accent/40 bg-accent-soft/60 p-4 text-sm">
        <span class="mt-0.5 rounded-full bg-accent px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider text-white">Sample</span>
        <p>
          <strong>Prices on this demo are samples, not NOURISH’s real prices.</strong> Dish names, descriptions and dietary marks
          are from the café’s own menu. Prices are in thousand rupiah (85K = Rp 85.000).
        </p>
      </div>
    )
  }

  {
    menu.categories.map((c) => (
      <section
        id={`${rootId}-${c.id}`}
        data-category={c.id}
        data-section={c.section}
        data-served-from={c.servedFrom}
        data-served-until={c.servedUntil}
        class="menu-cat scroll-mt-[calc(var(--header-h)+5.5rem)] border-t border-line py-10 first-of-type:border-t-0 first-of-type:pt-2"
        aria-labelledby={`${rootId}-${c.id}-h`}
      >
        <header class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
          <h3 id={`${rootId}-${c.id}-h`} class="display text-[clamp(1.9rem,5.5vw,3rem)]">
            {c.name}
          </h3>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            {servingLabel(c) && (
              <span data-serving-chip class="serving-chip inline-flex items-center gap-1.5 rounded-full bg-ink/5 px-2.5 py-1 font-semibold">
                <span class="size-1.5 rounded-full bg-current opacity-50" aria-hidden="true" />
                <span data-serving-text>{servingLabel(c)}</span>
              </span>
            )}
            {c.note && <span class="rounded-full bg-ink/5 px-2.5 py-1 text-muted">{c.note}</span>}
          </div>
        </header>

        {groups(c.items).map((g) => (
          <div class="menu-group not-first:mt-8" data-group>
            {g.group && <h4 class="eyebrow mb-2 border-b border-line pb-2 text-muted">{g.group}</h4>}
            <ul class:list={[c.style === 'cards' ? 'grid gap-3 sm:grid-cols-2 xl:grid-cols-3' : 'grid gap-x-10 md:grid-cols-2']}>
              {g.items.map((i) => (
                <li
                  id={`${anchorPrefix}-${i.id}`}
                  data-item
                  data-tags={i.tags.join(' ')}
                  data-text={searchText(c, i)}
                  class:list={[
                    'menu-item scroll-mt-[calc(var(--header-h)+6rem)]',
                    c.style === 'cards'
                      ? 'flex flex-col rounded-2xl bg-cream p-4 ring-1 ring-line transition-shadow hover:shadow-lg hover:shadow-ink/5'
                      : 'flex items-baseline gap-3 border-b border-dashed border-line py-3',
                    i.soldOut && 'opacity-55',
                  ]}
                >
                  {c.style === 'cards' ? (
                    <>
                      <div class="flex items-start justify-between gap-3">
                        <h5 class="font-display text-[1.05rem] font-extrabold uppercase leading-tight tracking-tight [font-stretch:108%]">{i.name}</h5>
                        {!labelled(i) && (
                          <span class="price shrink-0 text-right font-semibold tabular-nums" data-sample={menu.samplePrices || undefined} title={priceTitle}>
                            {formatPrices(i.prices)}
                          </span>
                        )}
                      </div>
                      {i.description && <p class="mt-1.5 text-sm leading-relaxed text-muted">{i.description}</p>}
                      {labelled(i) && (
                        <ul class="mt-3 flex flex-wrap gap-1.5 text-sm">
                          {i.prices.map((p) => (
                            <li class="rounded-full bg-paper px-2.5 py-1 ring-1 ring-line">
                              {p.label} <span class="price font-semibold tabular-nums" data-sample={menu.samplePrices || undefined} title={priceTitle}>{formatAmount(p.amount)}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-3">
                        {i.tags.map((t) => (
                          <span class="tag" data-tag={t} title={TAG_LABELS[t]}>
                            {t}
                            <span class="sr-only"> ({TAG_LABELS[t]})</span>
                          </span>
                        ))}
                        {i.soldOut && <span class="rounded-full bg-rose-100 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-rose-700">Sold out today</span>}
                        {i.addons?.map((a) => (
                          <span class="text-xs text-muted">
                            + {a.label} <span class="price" data-sample={menu.samplePrices || undefined}>{formatAmount(a.amount)}</span>
                          </span>
                        ))}
                      </div>
                    </>
                  ) : (
                    <>
                      <div class="min-w-0 flex-1">
                        <span class="font-semibold">{i.name}</span>
                        {i.tags.map((t) => (
                          <span class="tag ml-1.5 align-middle" data-tag={t} title={TAG_LABELS[t]}>
                            {t}
                          </span>
                        ))}
                        {i.description && <span class="block text-sm text-muted">{i.description}</span>}
                        {i.soldOut && <span class="ml-2 text-xs font-bold uppercase text-rose-700">Sold out</span>}
                      </div>
                      <span class="price max-w-[45%] shrink-0 text-right font-semibold tabular-nums" data-sample={menu.samplePrices || undefined} title={priceTitle}>
                        {formatPrices(i.prices)}
                      </span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}

        {c.addons && c.addons.length > 0 && (
          <p class="mt-4 text-sm text-muted">
            <span class="font-semibold text-ink">Add ons:</span>{' '}
            {c.addons.map((a, k) => (
              <span>
                {k > 0 && ' · '}
                {a.label} <span class="price" data-sample={menu.samplePrices || undefined}>{formatAmount(a.amount)}</span>
              </span>
            ))}
          </p>
        )}
      </section>
    ))
  }

  <div data-menu-empty hidden class="rounded-3xl bg-cream p-10 text-center ring-1 ring-line">
    <p class="display text-2xl">Nothing matches</p>
    <p class="mt-2 text-muted">Try fewer filters, or a different word.</p>
    <button type="button" data-menu-reset class="btn btn-ink mt-5">Clear filters</button>
  </div>

  <footer class="mt-6 grid gap-3 rounded-3xl bg-sand/70 p-5 text-sm sm:grid-cols-2 sm:p-6">
    <div>
      <p class="font-semibold">{menu.taxNote}</p>
      <p class="mt-1 text-muted">{menu.paymentNote}</p>
    </div>
    <div>
      <p class="text-muted"><strong class="text-ink">Allergens:</strong> {menu.allergenNote}</p>
      <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-muted">
        {
          TAGS.map((t) => (
            <span>
              <span class="tag" data-tag={t}>{t}</span> {TAG_LABELS[t]}
            </span>
          ))
        }
      </p>
    </div>
  </footer>
</div>

<style is:global>
  .tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.4;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  .tag[data-tag='V'] {
    color: #2f7a3a;
  }
  .tag[data-tag='VO'] {
    color: #5f8a2a;
  }
  .tag[data-tag='VG'] {
    color: #8a6d12;
  }
  .tag[data-tag='GF'] {
    color: #9b4a1c;
  }
  .price[data-sample] {
    text-decoration: underline dashed;
    text-decoration-color: color-mix(in oklab, var(--accent) 55%, transparent);
    text-underline-offset: 4px;
  }
  .menu-cat[data-serving='now'] .serving-chip {
    background: #dcf3e2;
    color: #1f6b35;
  }
  .menu-cat[data-serving='later'] .serving-chip,
  .menu-cat[data-serving='ended'] .serving-chip {
    background: #fbe9d6;
    color: #8a4b12;
  }
  .menu-item:target {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    animation: target-flash 1.6s ease-out;
  }
  @keyframes target-flash {
    0%,
    30% {
      background: var(--accent-soft);
    }
  }
</style>
