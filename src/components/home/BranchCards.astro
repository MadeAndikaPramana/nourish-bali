---
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import LiveStatus from '@/islands/LiveStatus';
import { getBranches } from '@/lib/content';
import { weeklySummary } from '@/lib/hours';
import { branchPhoto } from '@/lib/photos';
import { directionsUrl, helloMessage, waLink } from '@/lib/links';
import { formatCount } from '@/lib/format';

const branches = getBranches();
---

<section id="cafes" class="container-x scroll-mt-24 py-20 lg:py-28" aria-labelledby="cafes-title">
  <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="eyebrow text-accent">Three cafés, one menu family</p>
      <h2 id="cafes-title" class="display mt-3 text-[clamp(2.6rem,8vw,5.5rem)]">Pick your<br />Nourish</h2>
    </div>
    <p class="max-w-md text-muted">
      Two on the Bukit near Uluwatu, one in Berawa, Canggu. Uluwatu and Ungasan share a menu; Berawa has its own.
    </p>
  </div>

  <ul class="branch-cards flex flex-col gap-4 lg:h-[40rem] lg:flex-row">
    {
      branches.map((b) => (
        <li data-branch={b.slug} class="branch-card @container group relative flex min-h-[36rem] flex-col overflow-hidden rounded-[2rem] bg-ink text-paper lg:min-h-0">
          <Photo
            photo={branchPhoto[b.slug]}
            class="absolute inset-0"
            imgClass="transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105"
            sizes="(min-width: 1024px) 50vw, 100vw"
            transitionName={`branch-photo-${b.slug}`}
            tag={false}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/5" aria-hidden="true" />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: linear-gradient(to top, color-mix(in oklab, var(--accent) 70%, transparent), transparent 60%)" aria-hidden="true" />

          <div class="relative flex flex-1 flex-col justify-between gap-10 p-5 sm:p-7">
            <div class="flex items-start justify-between gap-3">
              <div class="flex flex-col items-start gap-2">
                <LiveStatus client:visible branch={b} fallback={weeklySummary(b.hours)[0].hours} />
                <span class="placeholder-tag !static">Placeholder photo</span>
              </div>
              <span class="flex items-center gap-1 rounded-full bg-ink/50 px-2.5 py-1 text-xs font-semibold backdrop-blur">
                <Icon name="star" size={13} class="text-amber-300" /> {b.rating.value} · {formatCount(b.rating.count)}
              </span>
            </div>

            <div>
              <p class="eyebrow text-paper/70">{b.area}</p>
              <h3 class="display mt-2 text-[min(14.5cqi,5.25rem)]" style={`view-transition-name: branch-title-${b.slug}`}>
                <a href={`/${b.slug}`} class="after:absolute after:inset-0 after:content-['']">{b.name}</a>
              </h3>
              <p class="mt-3 max-w-sm text-paper/85">{b.tagline}</p>
              <ul class="mt-3 text-sm text-paper/70">
                {weeklySummary(b.hours).map((r) => (
                  <li>
                    <Icon name="clock" size={13} class="mr-1 inline" />
                    {r.days} · {r.hours}
                  </li>
                ))}
              </ul>
              <div class="relative z-10 mt-5 flex flex-wrap gap-2">
                <a href={waLink(b.whatsapp, helloMessage(b.name))} target="_blank" rel="noopener" class="btn btn-wa !min-h-11 text-sm">
                  <Icon name="whatsapp" size={16} /> WhatsApp
                </a>
                <a href={directionsUrl(b.maps)} target="_blank" rel="noopener" class="btn !min-h-11 bg-paper text-sm text-ink hover:bg-white">
                  <Icon name="directions" size={15} /> Directions
                </a>
                <a href={`/${b.slug}#menu`} class="btn !min-h-11 bg-paper/15 text-sm text-paper backdrop-blur hover:bg-paper/25">
                  Menu <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Desktop accordion: the hovered/focused card widens, the others make room. */
  @media (min-width: 1024px) {
    .branch-card {
      flex: 1 1 0;
      transition: flex-grow 0.8s var(--ease-out-expo);
    }
    .branch-cards:hover .branch-card,
    .branch-cards:focus-within .branch-card {
      flex-grow: 0.8;
    }
    .branch-cards .branch-card:hover,
    .branch-cards .branch-card:focus-within {
      flex-grow: 1.7;
    }
  }
</style>
