---
import Icon from '@/components/Icon.astro';
import { getSite } from '@/lib/content';
import { instagramUrl } from '@/lib/links';

const { instagram } = getSite();
---

<section class="container-x py-10" aria-label="Instagram">
  <a
    href={instagramUrl(instagram)}
    target="_blank"
    rel="noopener"
    class="ig-cta group relative flex flex-col items-start gap-6 overflow-hidden rounded-[2rem] p-7 text-white sm:p-10 lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="relative">
      <p class="eyebrow text-white/75">Follow along</p>
      <p class="display mt-3 break-all text-[clamp(2.6rem,9vw,6.5rem)]">@{instagram}</p>
      <p class="mt-3 max-w-md text-white/85">New dishes, specials and the view from the café, on Instagram.</p>
    </div>
    <span class="relative grid size-20 shrink-0 place-items-center rounded-full bg-white text-ink transition-transform duration-500 group-hover:rotate-45 sm:size-28">
      <Icon name="arrow-up-right" size={36} />
    </span>
  </a>
</section>

<style>
  .ig-cta {
    background:
      radial-gradient(80% 120% at 0% 100%, #f9c46b 0%, transparent 55%),
      radial-gradient(80% 120% at 100% 0%, #7b3f93 0%, transparent 60%),
      linear-gradient(120deg, #e8607a, #b4527a);
  }
</style>
