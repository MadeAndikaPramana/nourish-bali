---
/**
 * Dish names running along a curved path (pattern after React Bits' Curved Loop),
 * as plain SVG + a tiny script. Pauses off-screen and for reduced motion.
 */
interface Props {
  words: string[];
}
const { words } = Astro.props;
const text = words.join('  ✺  ') + '  ✺  ';
---

<section class="curved-marquee relative -my-6 select-none overflow-hidden py-2 text-ink" aria-label="Signature dishes">
  <p class="sr-only">{words.join(', ')}</p>
  <svg viewBox="0 0 1440 220" class="block w-[180%] max-w-none -translate-x-[22%] sm:w-[130%] sm:-translate-x-[12%] lg:w-full lg:translate-x-0" aria-hidden="true">
    <defs>
      <path id="marquee-curve" d="M -80 150 C 300 30, 560 230, 880 120 S 1300 40, 1520 140" fill="none"></path>
    </defs>
    <text class="display fill-current" font-size="64" dominant-baseline="middle">
      <textPath href="#marquee-curve" startOffset="0" data-marquee>
        <tspan data-unit>{text}</tspan><tspan>{text}</tspan><tspan>{text}</tspan>
      </textPath>
    </text>
  </svg>
</section>

<script>
  const tp = document.querySelector<SVGTextPathElement>('[data-marquee]');
  const unit = document.querySelector<SVGTSpanElement>('[data-unit]');
  if (tp && unit && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let offset = 0;
    let running = false;
    let last = 0;
    const length = () => unit.getComputedTextLength();
    const step = (t: number) => {
      if (!running) return;
      const dt = last ? Math.min(t - last, 50) : 16;
      last = t;
      offset -= dt * 0.06;
      const L = length();
      if (L > 0 && offset <= -L) offset += L;
      tp.setAttribute('startOffset', `${offset}`);
      requestAnimationFrame(step);
    };
    new IntersectionObserver(([e]) => {
      running = e.isIntersecting;
      last = 0;
      if (running) requestAnimationFrame(step);
    }).observe(tp.closest('section')!);
  }
</script>
