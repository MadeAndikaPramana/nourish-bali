---
/** Small inline icon set (stroke icons follow Lucide's 24px grid). */
export type IconName =
  | 'whatsapp'
  | 'directions'
  | 'pin'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'clock'
  | 'star'
  | 'instagram'
  | 'facebook'
  | 'search'
  | 'menu'
  | 'close'
  | 'utensils'
  | 'paw'
  | 'leaf'
  | 'info';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}
const { name, class: className = '', size = 18, label } = Astro.props;
const role = label ? 'img' : undefined;
const hidden = label ? undefined : ('true' as const);
---

{
  name === 'whatsapp' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" role={role} aria-label={label} aria-hidden={hidden}>
      <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z" />
    </svg>
  ) : name === 'instagram' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={role} aria-label={label} aria-hidden={hidden}>
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
    </svg>
  ) : name === 'facebook' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={role} aria-label={label} aria-hidden={hidden}>
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
    </svg>
  ) : name === 'star' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" role={role} aria-label={label} aria-hidden={hidden}>
      <path d="m12 2.6 2.9 6.05 6.6.83-4.86 4.56 1.25 6.53L12 17.33l-5.89 3.24 1.25-6.53L2.5 9.48l6.6-.83L12 2.6Z" />
    </svg>
  ) : (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={role} aria-label={label} aria-hidden={hidden}>
      {name === 'directions' && (
        <>
          <path d="M3 11 22 2l-9 19-2-8-8-2Z" />
        </>
      )}
      {name === 'pin' && (
        <>
          <path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="3" />
        </>
      )}
      {name === 'arrow-right' && (
        <>
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </>
      )}
      {name === 'arrow-up-right' && (
        <>
          <path d="M7 7h10v10" />
          <path d="M7 17 17 7" />
        </>
      )}
      {name === 'clock' && (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 6v6l4 2" />
        </>
      )}
      {name === 'search' && (
        <>
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </>
      )}
      {name === 'menu' && (
        <>
          <path d="M4 8h16" />
          <path d="M4 16h16" />
        </>
      )}
      {name === 'close' && (
        <>
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </>
      )}
      {name === 'utensils' && (
        <>
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
          <path d="M7 2v20" />
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
        </>
      )}
      {name === 'paw' && (
        <>
          <circle cx="11" cy="4" r="2" />
          <circle cx="18" cy="8" r="2" />
          <circle cx="20" cy="16" r="2" />
          <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.05Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
        </>
      )}
      {name === 'leaf' && (
        <>
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
        </>
      )}
      {name === 'info' && (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </>
      )}
    </svg>
  )
}
