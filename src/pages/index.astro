---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import BrandBand from '@/components/home/BrandBand.astro';
import Intro from '@/components/home/Intro.astro';
import BranchStories from '@/components/home/BranchStories.astro';
import DayAtNourish from '@/components/home/DayAtNourish.astro';
import TakeHome from '@/components/home/TakeHome.astro';
import DietStats from '@/components/home/DietStats.astro';
import Reviews from '@/components/home/Reviews.astro';
import SouthBaliMap from '@/components/home/SouthBaliMap.astro';
import InstagramMosaic from '@/components/home/InstagramMosaic.astro';
import MenuCta from '@/components/home/MenuCta.astro';
import { getBranches, getSite } from '@/lib/content';
import { branchJsonLd } from '@/lib/seo';

const site = getSite();
---

<Base
  title="NOURISH Bali"
  description={`${site.tagline} Three cafés in Uluwatu, Ungasan and Berawa: opening hours, menus, WhatsApp and directions.`}
  jsonLd={getBranches().map((b) => branchJsonLd(b, Astro.site!))}
>
  <Hero />
  <Intro />
  <BrandBand />
  <BranchStories />
  <DayAtNourish />
  <TakeHome />
  <DietStats />
  <Reviews />
  <SouthBaliMap />
  <InstagramMosaic />
  <MenuCta />
</Base>
